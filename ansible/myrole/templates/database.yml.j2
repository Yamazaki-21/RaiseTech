default: &default
  adapter: mysql2
  encoding: utf8mb4
  pool: 5
  host: "{{ rds_endpoint }}"
  username: "{{ secret_result.value.username }}"
  password: "{{ secret_result.value.password }}"
  port: 3306

production:
  <<: *default
  database: rails_app_production

development:
  <<: *default
  database: rails_app_development

test:
  <<: *default
  database: rails_app_test

